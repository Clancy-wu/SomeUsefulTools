echo lh
mri_vol2surf --src ${sub_surf_src} --out ${sub_surf_lh} --hemi lh --regheader sub-1003 --trgsubject fsaverage5

echo rh
mri_vol3surf --src ${sub_surf_src} --out ${sub_surf_rh} --hemi rh --regheader sub-1003 --trgsubject fsaverage5

echo done.

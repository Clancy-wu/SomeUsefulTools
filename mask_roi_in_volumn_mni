# Step 1: tranform MNI coordinate to voxel location in FSLeyes

# Step 2: locate coordinate
#### x,y,z is the voxel coord, not scan coord, look in FSLeyes
fslmaths IMAGE.NII -mul 0 -add 1 -roi 79 1 75 1 22 1 0 1 PONSpoint
fslmaths PONSpoint -kernel sphere 7 -dilM PONSsphere7

# Step 3: make sphere ROI mask
fslmaths tmp -kernel sphere 10 -fmean -bin sphere

# Step 4: overlapped with grey matter mask to constrain the ROI in the grey matter
fslmaths gray_thr0.2.nii -mul sphere.nii.gz ROI_mask

import re
from itertools import product
from concurrent.futures import ProcessPoolExecutor
from tqdm import tqdm

def run(f, file):
    with ProcessPoolExecutor(max_workers=10) as executor:
        results = list(tqdm(executor.map(f, file), total=len(file)))
    return results

def get_opposite_mask(hemi):
    if hemi =='LH':
        return '/home/clancy/data/dti_dvlpfc_amyg_project/atlas/MNI152_T1_1mm_brain_mask_RH.nii.gz'
    if hemi == 'RH':
        return '/home/clancy/data/dti_dvlpfc_amyg_project/atlas/MNI152_T1_1mm_brain_mask_LH.nii.gz'

def edit_tck_by_index(tck_file, out_dir, roi_mask, exclude_mask):
    file_in = tck_file
    file_out = os.path.join(out_dir, os.path.basename(tck_file))
    edit_commond = f'tckedit {file_in} -include {roi_mask} -exclude {exclude_mask} {file_out} -quiet'
    os.system(edit_commond)
    return file_out

def edit_tck_by_index_batch(args):
    return edit_tck_by_index(*args)

def binary_tck(tck_file):
    file_in = tck_file
    file_out = tck_file.replace('.tck', '.nii.gz')
    ref_fsl = '/home/clancy/data/dti_dvlpfc_amyg_project/atlas/MNI152_T1_1mm_brain.nii.gz'
    os.system(f'tckmap {file_in} -template {ref_fsl} {file_out} -quiet')
    os.system(f'fslmaths {file_out} -thr 0 -bin {file_out}')

